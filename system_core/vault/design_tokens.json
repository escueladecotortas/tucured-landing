{
  "system": "Nexus OS Design Tokens",
  "version": "10.0.0",
  "framework": "Tailwind CSS v4.0",
  "colorPalette": {
    "background": {
      "deep": "#090d16",
      "surface": "#0f172a",
      "surfaceSubtle": "#1e293b",
      "black": "#000000"
    },
    "brand": {
      "primary": "#f59e0b",
      "primaryLight": "#fbbf24",
      "primaryDark": "#d97706",
      "primaryGlow": "rgba(245, 158, 11, 0.3)"
    },
    "status": {
      "success": "#10b981",
      "successMuted": "rgba(16, 185, 129, 0.15)",
      "warning": "#f59e0b",
      "warningMuted": "rgba(245, 158, 11, 0.15)",
      "error": "#f43f5e",
      "errorMuted": "rgba(244, 63, 94, 0.15)",
      "info": "#06b6d4"
    },
    "text": {
      "primary": "#f8fafc",
      "secondary": "#cbd5e1",
      "muted": "#94a3b8",
      "subtle": "#64748b"
    },
    "border": {
      "default": "#1e293b",
      "subtle": "#334155",
      "highlight": "#f59e0b"
    }
  },
  "typography": {
    "sans": ["Plus Jakarta Sans", "system-ui", "sans-serif"],
    "mono": ["JetBrains Mono", "monospace"],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    }
  },
  "radii": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "amberGlow": "0 0 20px rgba(245, 158, 11, 0.25)",
    "card": "0 10px 25px -5px rgba(0, 0, 0, 0.5)",
    "modal": "0 25px 50px -12px rgba(0, 0, 0, 0.7)"
  }
}
